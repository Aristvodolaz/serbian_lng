# Copy to .env.production on the server and fill in. Never commit the real file.
# Public address of the site, e.g. https://rec-site.example.com (no trailing slash)
SITE_URL=
# Telegram bot for waitlist sign-ups (new token, after /revoke)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Host port for the website (container always listens on 3002)
WEB_PORT=3002
