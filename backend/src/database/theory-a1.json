          [ { "cyrillic": "3. л. јед.", "latin": "3. os." }, { "cyrillic": "он / она", "latin": "on / ona" }, { "cyrillic": "Она је учитељица.", "latin": "Ona je učiteljica." } ],
          [ { "cyrillic": "1. л. мн.", "latin": "1. os. mn." }, { "cyrillic": "ми", "latin": "mi" }, { "cyrillic": "Ми учимо српски.", "latin": "Mi učimo srpski." } ],
          [ { "cyrillic": "2. л. мн.", "latin": "2. os. mn." }, { "cyrillic": "ви", "latin": "vi" }, { "cyrillic": "Ви живите у Београду.", "latin": "Vi živete u Beogradu." } ],
          [ { "cyrillic": "3. л. мн.", "latin": "3. os. mn." }, { "cyrillic": "они / оне", "latin": "oni / one" }, { "cyrillic": "Они су студенти.", "latin": "Oni su studenti." } ]
        ] },
        { "type": "example", "cyrillic": "Он је из Новог Сада.", "latin": "On je iz Novog Sada.", "translationRu": "Он из Нови-Сада.", "translationEn": "He is from Novi Sad." },
