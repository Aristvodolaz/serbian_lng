# Copy to .env on the server and fill in real values.
# Used by docker-compose.prod.yml for both the postgres and app services.

NODE_ENV=production
PORT=3000
APP_PORT=3100

# Postgres — POSTGRES_* configure the postgres container itself; DATABASE_URL
# is how the app connects to it. Host must be "postgres" (the compose service
# name), not "localhost" — the app talks to Postgres over the compose network.
POSTGRES_USER=rec
POSTGRES_PASSWORD=test-strong-password
POSTGRES_DB=rec_db
DATABASE_URL=postgresql://rec:test-strong-password@postgres:5432/rec_db

# Auto-creates tables from entities. Fine for this MVP's first deploy; switch
# to TypeORM migrations before this handles real user data — see backend/README.md.
TYPEORM_SYNCHRONIZE=true

# Generate real secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=test-access-secret-not-for-real-use-1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-not-for-real-use-0987654321
JWT_REFRESH_EXPIRES_IN=30d
