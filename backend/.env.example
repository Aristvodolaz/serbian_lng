PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://rec:rec@localhost:5433/rec_db

# Set to "true" only in local dev — auto-creates tables from entities.
# Production should use migrations instead.
TYPEORM_SYNCHRONIZE=true

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Google Cloud Text-to-Speech (Serbian)
# Set path to service account JSON key, or use application default credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
TTS_VOICE_NAME=sr-Latn-standard
