<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release Info.plist. Xcode merges its generated keys (bundle name,
	     version, scene manifest…) into this file, so only the ones it cannot
	     generate live here. Debug builds use Info-Debug.plist instead, which
	     adds the App Transport Security exception the plain-HTTP dev server
	     needs — the same split Android makes with src/debug/AndroidManifest.xml. -->
	<key>RecAPIBaseURL</key>
	<string>$(REC_API_BASE_URL)</string>
</dict>
</plist>
