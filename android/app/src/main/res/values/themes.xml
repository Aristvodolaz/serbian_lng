<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose owns all real theming (see ui/theme). This XML theme only
         needs to exist so the manifest has a valid pre-Compose window theme
         (splash background) to point at. -->
    <style name="Theme.Rec" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
    </style>
</resources>
